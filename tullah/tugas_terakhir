<script>
        document.addEventListener('DOMContentLoaded', () => {
            // Pulsing animation for the notification dot
            const dot = document.querySelector('.bg-error');
            if (dot) {
                setInterval(() => {
                    dot.style.transform = 'scale(1.2)';
                    setTimeout(() => { dot.style.transform = 'scale(1)'; }, 300);
                }, 2000);
            }

            // Simple hover effect for cards
            const cards = document.querySelectorAll('.bg-surface-container-lowest');
            cards.forEach(card => {
                card.addEventListener('mouseenter', () => {
                    card.style.borderColor = 'rgba(0, 52, 111, 0.3)';
                });
                card.addEventListener('mouseleave', () => {
                    card.style.borderColor = '#E9ECEF';
                });
            });
        });
    </script>
